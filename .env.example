# StandUp Dashboard - Environment Configuration
# Copy this to .env and change the values before deploying

# Database password
DB_PASSWORD=changeme_db_password

# JWT secret for authentication tokens (use a long random string)
JWT_SECRET=changeme_jwt_secret_use_something_random_and_long_here

# Allowed origins for CORS (comma-separated, defaults to http://localhost:8880)
# ALLOWED_ORIGINS=https://your-domain.com

# ─── SAML / SSO Configuration (optional) ─────────────────────────────────────
# To enable SSO, set SAML_ENTRYPOINT and SAML_ISSUER, then run:
#   docker compose --profile sso up
#
# Leave unset to use only local password authentication.

# SAML_ENTRYPOINT=http://localhost:8180/auth/realms/standup/protocol/saml
# SAML_ISSUER=standup
# SAML_CALLBACK_URL=http://localhost:8880/api/auth/saml/acs
# SAML_CERT=<keycloak signing cert, base64, no PEM headers>

# Frontend URL — where to redirect after SSO login (defaults to '/')
# Set this to your public URL in production
# FRONTEND_URL=https://your-domain.com

# Default role for auto-provisioned SSO users (owner|manager|team_lead|employee)
# SAML_DEFAULT_ROLE=employee

# Set to 'true' to hide local password login (SSO only)
# AUTH_LOCAL_DISABLED=false

# Keycloak admin console password (http://localhost:8180/auth/)
# KEYCLOAK_ADMIN_PASSWORD=admin
